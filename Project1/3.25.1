#include <iostream>
using namespace std;

int main() {
	int facto = 1;
	int n;
	cout << "Deme un numero no negativo: ";
	cin >> n;

	if (n < 0) {
		cout << "El numero administrado no puede tener factorial debido a que o es un 0 o es un numero negativo." << "\n";

	}
	else {
		int contador = n;
		while (contador > 1) {
			facto *= contador;
			contador--;
		}
		cout << n << "! = " << facto << endl;
	}
	return 0;
}
